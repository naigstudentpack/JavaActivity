<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="TOP_CENTER" prefWidth="800" prefHeight="600" style="-fx-padding: 30; -fx-background-color: #f0f0f0;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.studenttaskmanager.controller.DashboardController">

    <Label text="STUDENT TASK MANAGER" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Label fx:id="welcomeLabel" style="-fx-font-size: 18px; -fx-text-fill: #34495e;"/>

    <Separator/>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="New Task:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <TextField fx:id="taskField" promptText="Enter your task..." prefWidth="400" style="-fx-font-size: 14px;"/>
        <Button text="Add Task" onAction="#addTask" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 15;"/>
    </HBox>

    <Label text="My Tasks:" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
    <ListView fx:id="taskListView" prefHeight="300" style="-fx-font-size: 14px;"/>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Mark as Done" onAction="#markTaskDone" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20;"/>
        <Button text="Delete Task" onAction="#deleteTask" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20;"/>
        <Button text="Logout" onAction="#logout" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20;"/>
    </HBox>

</VBox>