<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" alignment="CENTER" prefWidth="400" prefHeight="300" style="-fx-padding: 30; -fx-background-color: #f0f0f0;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.studenttaskmanager.controller.LoginController">

    <Label text="STUDENT TASK MANAGER" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <Label text="Login to Continue" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

    <TextField fx:id="usernameField" promptText="Username" prefWidth="300" style="-fx-font-size: 14px; -fx-padding: 10;"/>
    <PasswordField fx:id="passwordField" promptText="Password" prefWidth="300" style="-fx-font-size: 14px; -fx-padding: 10;"/>

    <Button text="LOGIN" onAction="#handleLogin" prefWidth="300" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10;"/>

</VBox>